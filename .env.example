BETTER_AUTH_SECRET=
DATABASE_URL=
VITE_AUTH_ENABLED=

# --- GMGN bridge (src/lib/gmgn.ts) ---
# Local GMGN bridge URL. Default: http://127.0.0.1:8000
GMGN_BASE_URL=http://127.0.0.1:8000
# Chain for the GMGN screen (sol | bsc | base | eth | robinhood). Default: sol
GMGN_CHAIN=sol
# 1/true/yes to also accept mock-adapter rows when the bridge has no API key.
# Leave unset in production — mock rows are for testing only.
GMGN_ALLOW_MOCK=
